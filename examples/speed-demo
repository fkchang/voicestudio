#!/usr/bin/env ruby
# frozen_string_literal: true

# Self-documenting speed demo: each clip announces its --speed value, then speaks the same paragraph
# with the same seed, so the clips differ only in speed.
# usage: speed-demo OUT_DIR [--voice NAME] [SPEED ...]   then: play-manifest OUT_DIR
require 'json'
require 'fileutils'

args = ARGV.dup
dir = args.shift or abort 'usage: speed-demo OUT_DIR [--voice NAME] [SPEED ...]'
voice = args.delete_at(args.index('--voice') + 1) if args.include?('--voice')
args.delete('--voice')
speeds = args.empty? ? %w[1.0 1.15 1.3 1.5 1.75 2.0] : args
speak = File.expand_path('../bin/speak', __dir__)
FileUtils.mkdir_p(dir)

paragraph = 'Here is the plan for the quarter. We ship the new onboarding first, then fix the billing ' \
            'edge cases, and finish with the reporting work. Every step has an owner and a date.'
segments = speeds.each_with_index.map do |speed, i|
  text = "Speed #{speed}. #{paragraph}"
  file = File.expand_path(File.join(dir, format('%02d-speed-%s.wav', i + 1, speed)))
  cmd = [speak, text, '--speed', speed, '--seed', '7', '--out', file]
  cmd += ['--voice', voice] if voice
  system(*cmd, out: File::NULL) || abort("speak failed for speed #{speed}")
  warn "rendered speed #{speed}"
  { 'index' => i + 1, 'text' => text, 'file' => file }
end
File.write(File.join(dir, 'manifest.json'), JSON.pretty_generate('segments' => segments))
puts File.expand_path(dir)
